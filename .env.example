# Copy to .env for local work. Never commit real values.
# In Codespaces: Settings → Secrets and variables → Codespaces.
# On Render: the service's Environment tab.

PORT=3000
# Public address of the app, used to build the Google redirect URI.
BASE_URL=http://localhost:3000

# Neon connection string. Without it the app runs on an in-memory store (data is lost on restart).
DATABASE_URL=

# Google OAuth client (Testing mode). Redirect URI to register: ${BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini API. Without a key the suggestion feature uses the rule-based fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MODEL_TIMEOUT_MS=8000

# Used by `npm run seed` to create the first admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Used by `npm run mcp`: an ordinary session token (create one on the "Моите резервации" screen).
LAB_SESSION_TOKEN=
